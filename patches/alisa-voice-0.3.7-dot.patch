+        handset_cue_block(true,block,pickup);handset_cue_block(false,block,hangup);
+        for(int i=0;i<960;++i){
+            assert(pickup[2*i]==pickup[2*i+1]);assert(hangup[2*i]==hangup[2*i+1]);
+            loudest=std::max({loudest,std::abs(int(pickup[2*i])),std::abs(int(hangup[2*i]))});
+            different|=pickup[2*i]!=hangup[2*i];
+        }
+    }
+    assert(loudest>500 && loudest<10000);assert(different);
+    for(short sample:pickup)assert(sample==0);
+    for(short sample:hangup)assert(sample==0);
+}
