+inline void ringback_block(unsigned int block,short *samples){
+    constexpr double pi=3.141592653589793;
+    unsigned int cycle=block%300;
+    for(int i=0;i<960;++i){
+        double t=(cycle*960+i)/48000.0;
+        double envelope=cycle<100?std::clamp(std::min(t/.015,(2.0-t)/.015),0.0,1.0):0.0;
+        short value=static_cast<short>(2200*envelope*(std::sin(2*pi*440*t)+std::sin(2*pi*480*t)));
+        samples[i*2]=samples[i*2+1]=value;
+    }
+}
