+#pragma once
+#include <nlohmann/json.hpp>
+#include <string>
+#include <cctype>
+
+struct DotOffer {
+    std::string url;
+    std::string body;
+};
+
+inline DotOffer dot_offer(const std::string &dot, const std::string &sdp) {
+    return {"https://chatgpt.com/backend-api/tbo/" + dot + "/voice/calls",
+            nlohmann::json{{"instant_connect", true}, {"sdp", sdp}}.dump()};
+}
+
+inline std::string dot_call_url(const std::string &dot, const std::string &location) {
+    const std::string root = "https://chatgpt.com/backend-api/tbo/" + dot + "/voice/calls/";
+    const std::string rtc_prefix = "/v1/realtime/calls/";
+    const std::string url = location.rfind(rtc_prefix, 0) == 0 ? root + location.substr(rtc_prefix.size()) :
+        location.rfind("/", 0) == 0 ? "https://chatgpt.com" + location : location;
+    if (url.rfind(root, 0) != 0 || url.size() == root.size()) return {};
+    for (char c : url.substr(root.size()))
+        if (!std::isalnum(static_cast<unsigned char>(c)) && c != '_' && c != '-') return {};
+    return url;
+}
