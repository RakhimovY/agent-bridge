diff --git a/engines/native/tests/dot_signaling.cpp b/engines/native/tests/dot_signaling.cpp
new file mode 100644
index 0000000..e75dce9
--- /dev/null
+++ b/engines/native/tests/dot_signaling.cpp
@@ -0,0 +1,17 @@
+#include "../native/dot_signaling.hpp"
+#include <nlohmann/json.hpp>
+#include <cassert>
+
+int main() {
+    const std::string dot = "account-id~dot-id";
+    const std::string sdp = "v=0\r\na=example:quoted\"value\r\n";
+    auto request = dot_offer(dot, sdp);
+    assert(request.url == "https://chatgpt.com/backend-api/tbo/" + dot + "/voice/calls");
+    const auto body = nlohmann::json::parse(request.body);
+    assert(body.at("instant_connect") == true);
+    assert(body.at("sdp") == sdp);
+    assert(body.size() == 2);
+    assert(dot_call_url(dot, "/backend-api/tbo/" + dot + "/voice/calls/rtc_test") == request.url + "/rtc_test");
+    assert(dot_call_url(dot, "/v1/realtime/calls/rtc_test") == request.url + "/rtc_test");
+    assert(dot_call_url(dot, "https://evil.example/voice/calls/rtc_test").empty());
+}
